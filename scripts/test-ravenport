#!/bin/sh
set -eu

cd "$(dirname "$0")/.."

: "${ARCHCERT_TEST_DATABASE_URL:?set a development PostgreSQL URL; tests create isolated schemas}"

cargo test -p archcert-storage --test postgres --test ironcrest --test release --test commands --locked -- --ignored --nocapture

cargo test -p archcert-control-plane --test commands --locked -- --ignored --nocapture

mkdir -p target/ravenport-build
archcert_test_build_metadata=$(mktemp target/ravenport-build/controller.XXXXXX)
trap 'rm -f "$archcert_test_build_metadata"' EXIT

cargo build -p archcert-controller --locked --message-format=json > "$archcert_test_build_metadata"

archcert_test_controller_binary=$(python3 - "$archcert_test_build_metadata" <<'PY'
import json
from pathlib import Path
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    messages = [json.loads(line) for line in stream if line.strip()]

executables = {
    message["executable"]
    for message in messages
    if message.get("reason") == "compiler-artifact"
    and message["target"]["name"] == "archcert-controller"
    and "bin" in message["target"]["kind"]
    and message.get("executable")
}
finished = [message for message in messages if message.get("reason") == "build-finished"]

if len(executables) != 1 or len(finished) != 1 or not finished[0]["success"]:
    raise SystemExit("A successful controller build with one executable is required")

print(Path(next(iter(executables))).resolve(strict=True))
PY
)

ARCHCERT_TEST_CONTROLLER_BINARY="$archcert_test_controller_binary" \
    cargo test -p archcertd --locked -- --ignored --nocapture
