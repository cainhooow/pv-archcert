#!/usr/bin/env python3
"""Controlled development demonstration; requires pre-provisioned rootless OCI.
No target Python is executed on the controller. System Git only prepares fixtures.
"""
import json
import os
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
os.chdir(ROOT)
CLIENT = os.environ["ARCHCERT_TEST_DOCKER"]
ENDPOINT = os.environ["ARCHCERT_TEST_ENDPOINT"]
IMAGE = os.environ["ARCHCERT_TEST_IMAGE"]
BINARY = ROOT / "target/debug/archcert"
OUTPUT = ROOT / "docs/policy"
PROJECT = "00000000-0000-4000-8000-000000000004"


def command(argv, **kwargs):
    result = subprocess.run([str(a) for a in argv], capture_output=True, **kwargs)

    if result.returncode:
        raise RuntimeError(result.stderr.decode(errors="replace"))

    return result.stdout.decode()


def evaluate(
    git_dir, commit, repository, workspaces, name, config_args, docker=CLIENT, expected_status=0
):
    source = json.loads(
        command(
            [
                BINARY,
                "source",
                "inspect",
                git_dir,
                commit,
                "--project",
                PROJECT,
                "--repository",
                repository,
            ]
        )
    )
    argv = [
        BINARY,
        "evaluate",
        "--git-dir",
        git_dir,
        "--commit",
        commit,
        "--snapshot",
        source["identity"]["snapshot_sha256"],
        "--project",
        PROJECT,
        "--repository",
        repository,
        "--workspace-root",
        workspaces,
        "--profile",
        "python",
        "--image",
        IMAGE,
        "--docker",
        docker,
        "--endpoint",
        ENDPOINT,
    ] + config_args
    result = subprocess.run([str(a) for a in argv], capture_output=True)

    if result.returncode != expected_status:
        raise RuntimeError(result.stderr.decode(errors="replace"))

    report = json.loads(result.stdout)

    assert report["kind"] == "UNSIGNED POLICY EVALUATION"
    assert report["notice"] == "NOT A CERTIFICATE"
    assert report["certificate"] == "NOT ISSUED"

    (OUTPUT / name).write_text(json.dumps(report, indent=2, ensure_ascii=False) + "\n")

    return report


def check(report, verdict, eligibility):
    evaluation = report["evaluation"]
    test = next(p for p in evaluation["properties"] if p["property"] == "TEST_SUITE_COMPLETES")

    assert test["verdict"] == verdict, test
    assert evaluation["eligibility"] == eligibility, evaluation

    print(verdict + " / " + eligibility, flush=True)


with tempfile.TemporaryDirectory(prefix="demo-", dir=ROOT / "target/m4a") as temporary:
    temporary = Path(temporary)
    repo = temporary / "git-source"
    repo.mkdir(mode=0o700)
    workspaces = temporary / "workspaces"
    workspaces.mkdir(mode=0o700)
    git_env = {
        **os.environ,
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": "/dev/null",
        "GIT_AUTHOR_NAME": "ArchCert fixture",
        "GIT_AUTHOR_EMAIL": "fixture@example.invalid",
        "GIT_COMMITTER_NAME": "ArchCert fixture",
        "GIT_COMMITTER_EMAIL": "fixture@example.invalid",
        "GIT_AUTHOR_DATE": "2000-01-01T00:00:00Z",
        "GIT_COMMITTER_DATE": "2000-01-01T00:00:00Z",
    }

    def git(*args):
        return command(
            ["git", "-c", "core.hooksPath=/dev/null", "-c", "gc.auto=0", *args],
            cwd=repo,
            env=git_env,
        ).strip()

    git("init", "--template=", "--initial-branch=fixture")
    code = (ROOT / "tests/fixtures/policy-target/checks.py").read_text()
    (repo / "checks.py").write_text(code)
    git("add", "checks.py")
    git("commit", "-m", "controlled passing target")
    passing = git("rev-parse", "HEAD")
    args = ["--authority-config", ROOT / "docs/policy/CONTROLLED_AUTHORITY.toml"]
    report = evaluate(
        repo / ".git",
        passing,
        "archcert/controlled-policy",
        workspaces,
        "CONTROLLED_PROVEN.json",
        args,
    )
    check(report, "PROVEN", "ELIGIBLE_FOR_CERTIFICATION")

    assert all(p["verdict"] == "PROVEN" for p in report["evaluation"]["properties"])

    (repo / "checks.py").write_text(code.replace("return a + b", "return a + b + 1"))
    git("add", "checks.py")
    git("commit", "-m", "controlled failing test target")
    failing = git("rev-parse", "HEAD")
    report = evaluate(
        repo / ".git",
        failing,
        "archcert/controlled-policy",
        workspaces,
        "CONTROLLED_FAILED.json",
        args,
        expected_status=1,
    )
    check(report, "FAILED", "NOT_ELIGIBLE")
    report = evaluate(
        repo / ".git",
        passing,
        "archcert/controlled-policy",
        workspaces,
        "CONTROLLED_INCONCLUSIVE.json",
        args,
        docker="/usr/bin/false",
        expected_status=1,
    )
    check(report, "INCONCLUSIVE", "NOT_ELIGIBLE")
    bottle = ROOT / "target/m3-bottle/.git"
    report = evaluate(
        bottle,
        "8ec5fe29420d14998c0d86885083983eaea8b839",
        "bottlepy/bottle",
        workspaces,
        "BOTTLE_NOT_PROVEN.json",
        ["--config", ROOT / "docs/runner/BOTTLE_REQUEST.toml"],
    )
    check(report, "NOT_PROVEN", "NOT_ELIGIBLE")

    assert not list(workspaces.iterdir()), "source cleanup failed"
