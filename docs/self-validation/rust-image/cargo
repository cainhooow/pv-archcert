#!/usr/bin/python3 -I
"""Authority image launcher: fixed offline tooling and writable build output."""
import os
import sys

cargo_home = '/home/archcert/.cargo'
os.makedirs(cargo_home, exist_ok=True)
for directory in ['registry']:
    link = cargo_home + '/' + directory
    if not os.path.lexists(link):
        os.symlink('/opt/archcert/cargo/' + directory, link)

# cargo-deny locks the advisory root even in frozen mode. Keep only that
# operational lock directory writable; each pinned advisory repository stays ro.
advisory_home = cargo_home + '/advisory-dbs'
os.makedirs(advisory_home, exist_ok=True)
for entry in os.scandir('/opt/archcert/cargo/advisory-dbs'):
    if entry.is_dir():
        link = advisory_home + '/' + entry.name
        if not os.path.lexists(link):
            os.symlink(entry.path, link)

# Test harnesses create executable mock fixtures; /tmp remains noexec.
os.makedirs('/work/tmp', mode=0o700, exist_ok=True)
os.environ.update(TMPDIR='/work/tmp', RUST_TEST_THREADS='1', CARGO_HOME=cargo_home, RUSTUP_HOME='/usr/local/rustup',
                  CARGO_TARGET_DIR='/work/target', CARGO_NET_OFFLINE='true',
                  RUSTDOCFLAGS='-D warnings', CARGO_BUILD_JOBS='2',
                  CARGO_PROFILE_DEV_DEBUG='0', CARGO_PROFILE_TEST_DEBUG='0',
                  CARGO_INCREMENTAL='0',
                  RUSTC='/usr/local/cargo/bin/rustc', RUSTDOC='/usr/local/cargo/bin/rustdoc',
                  PATH='/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin')
os.execv('/usr/local/cargo/bin/cargo', ['/usr/local/cargo/bin/cargo'] + sys.argv[1:])
