#!/usr/bin/python3 -I
"""Authority image launcher: fixed offline tooling and writable build output."""
import os
import sys

cargo_home = '/home/archcert/.cargo'
os.makedirs(cargo_home, exist_ok=True)
for directory in ['registry', 'advisory-dbs']:
    link = cargo_home + '/' + directory
    if not os.path.lexists(link):
        os.symlink('/opt/archcert/cargo/' + directory, link)

os.environ.update(CARGO_HOME=cargo_home, RUSTUP_HOME='/usr/local/rustup',
                  CARGO_TARGET_DIR='/work/target', CARGO_NET_OFFLINE='true',
                  RUSTDOCFLAGS='-D warnings', CARGO_BUILD_JOBS='2',
                  CARGO_PROFILE_DEV_DEBUG='0', CARGO_PROFILE_TEST_DEBUG='0',
                  CARGO_INCREMENTAL='0',
                  RUSTC='/usr/local/cargo/bin/rustc', RUSTDOC='/usr/local/cargo/bin/rustdoc',
                  PATH='/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin')
os.execv('/usr/local/cargo/bin/cargo', ['/usr/local/cargo/bin/cargo'] + sys.argv[1:])
